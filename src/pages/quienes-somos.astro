---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import BrandStorySection from "../components/sections/about/BrandStorySection.astro";
import MissionVisionSection from "../components/sections/about/MissionVisionSection.astro";
import ValuesGrid from "../components/sections/about/ValuesGrid.astro";
import WhyChooseUs from "../components/sections/about/WhyChooseUs.astro";
import Container from "../components/ui/Container.astro";
import CTABox from "../components/ui/CTABox.astro";
import { pageImages } from "../data/media";
---

<BaseLayout
  title="Quienes somos | SUConsulting"
  description="Conoce la vision, el proposito y la propuesta institucional de SUConsulting."
>
  <PageHeader
    eyebrow="Identidad institucional"
    title="Consultoria empresarial con proposito, servicio y vision de largo plazo."
    description="SUConsulting acompana a lideres, emprendedores y organizaciones desde una mirada estrategica y una base de principios. Nuestra propuesta combina estructura empresarial, red cristiana y vocacion real de servicio."
    image={pageImages.about}
    imageAlt="Edificio corporativo institucional"
    highlights={[
      "Base cristiana orientada a servicio e integridad.",
      "Acompanamiento para empresas, emprendedores y familias empresarias.",
      "Crecimiento con orden, criterio y sostenibilidad."
    ]}
    primaryCtaHref="/agendar-cita"
    primaryCtaLabel="Agendar una reunion"
    secondaryCtaHref="/contacto"
    secondaryCtaLabel="Hablar con nosotros"
  />

  <BrandStorySection />
  <MissionVisionSection />
  <ValuesGrid />
  <WhyChooseUs />

  <section class="section-space-sm">
    <Container>
      <CTABox
        tone="dark"
        eyebrow="Siguiente paso"
        title="Llevemos el proposito de tu organizacion a una conversacion mas clara."
        description="Si buscas una consultora seria, cercana y preparada para acompanar decisiones importantes, conversemos sobre el siguiente paso de tu empresa."
        primaryCtaHref="/agendar-cita"
        primaryCtaLabel="Agendar una reunion"
        secondaryCtaHref="/servicios"
        secondaryCtaLabel="Explorar servicios"
      />
    </Container>
  </section>
</BaseLayout>
