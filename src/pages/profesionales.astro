---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
import IconBox from "../components/ui/IconBox.astro";
import CTABox from "../components/ui/CTABox.astro";
import ExpertisSection from "../components/sections/professionals/ExpertisSection.astro";
import ProfessionalGrid from "../components/sections/professionals/ProfessionalGrid.astro";
import { pageImages } from "../data/media";

const methodology = [
  {
    title: "Escucha",
    description: "Entendemos el contexto antes de proponer.",
    accent: "magenta" as const,
    mark: "01"
  },
  {
    title: "Diagnostico",
    description: "Leemos el negocio con criterio y foco.",
    accent: "blue" as const,
    mark: "02"
  },
  {
    title: "Propuesta",
    description: "Aterrizamos una ruta clara y aplicable.",
    accent: "green" as const,
    mark: "03"
  },
  {
    title: "Acompanamiento",
    description: "Seguimos de cerca la ejecucion y el avance.",
    accent: "orange" as const,
    mark: "04"
  }
];
---

<BaseLayout
  title="Profesionales | SUConsulting"
  description="Conoce al equipo consultivo de SUConsulting y las areas de experiencia que respaldan cada acompanamiento."
>
  <PageHeader
    eyebrow="Equipo profesional"
    title="Consultores preparados para procesos, decisiones y conversaciones de alto valor."
    description="Nuestro equipo combina experiencia consultiva, especialidades complementarias y una metodologia pensada para dar confianza desde el primer intercambio."
    image={pageImages.professionals}
    imageAlt="Equipo profesional de consultoria"
    highlights={[
      "Experiencia en gestion, estrategia, finanzas y tecnologia.",
      "Perfiles consultivos con acompanamiento humano y sobrio.",
      "Red profesional preparada para contextos empresariales diversos."
    ]}
    primaryCtaHref="/agendar-cita"
    primaryCtaLabel="Agendar una reunion"
    secondaryCtaHref="/contacto"
    secondaryCtaLabel="Hablar con nosotros"
  />

  <ExpertisSection />
  <ProfessionalGrid />

  <section class="section-space-sm bg-white">
    <Container>
      <div class="grid gap-6 xl:grid-cols-[0.38fr_0.62fr]">
        <Card variant="dark" class="rounded-[2rem] p-7 md:p-9 suc-pattern">
          <p class="text-sm font-black uppercase tracking-[0.18em] text-white/66">
            Metodo del equipo
          </p>
          <h2 class="mt-4 text-4xl font-black leading-none tracking-[-0.06em] text-white md:text-5xl">
            Una forma de trabajo que da tranquilidad al cliente.
          </h2>
          <p class="mt-5 text-[15px] leading-8 text-white/76">
            Escuchamos, interpretamos y proponemos con criterio. La experiencia debe sentirse profesional,
            cercana y suficientemente clara para que la organizacion avance con seguridad.
          </p>
        </Card>

        <div class="grid gap-5 md:grid-cols-2">
          {methodology.map((item, index) => (
            <Card variant="premium" class:list={["card-premium h-full rounded-[1.6rem] p-6", "reveal", index > 0 && `reveal-delay-${Math.min(index, 3)}`]}>
              <IconBox accent={item.accent} value={item.mark} />
              <h3 class="mt-5 text-2xl font-black tracking-[-0.04em] text-[var(--brand-navy)]">
                {item.title}
              </h3>
              <p class="mt-3 text-[15px] leading-7 text-[var(--ink-2)]">
                {item.description}
              </p>
            </Card>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="section-space-sm">
    <Container>
      <CTABox
        tone="dark"
        eyebrow="Conversemos"
        title="Si necesitas el perfil correcto para una etapa importante, podemos ayudarte a encontrarlo."
        description="Agenda una conversacion y revisemos que tipo de acompaniamiento, experiencia o especialidad necesita hoy tu organizacion."
        primaryCtaHref="/agendar-cita"
        primaryCtaLabel="Agendar una reunion"
        secondaryCtaHref="/servicios"
        secondaryCtaLabel="Ver servicios"
      />
    </Container>
  </section>
</BaseLayout>
