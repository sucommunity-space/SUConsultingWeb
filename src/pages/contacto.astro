---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
import CTABox from "../components/ui/CTABox.astro";
import ContactChannels from "../components/sections/contact/ContactChannels.astro";
import ContactFormSection from "../components/sections/contact/ContactFormSection.astro";
import ContactInfoSection from "../components/sections/contact/ContactInfoSection.astro";
import MapSection from "../components/sections/contact/MapSection.astro";
import { pageImages } from "../data/media";
---

<BaseLayout
  title="Contacto | SUConsulting"
  description="Contacta con SUConsulting de forma profesional, clara y confiable."
>
  <PageHeader
    eyebrow="Contacto empresarial"
    title="Conversemos sobre el crecimiento y la siguiente decision de tu empresa."
    description="Si quieres explorar un servicio, agendar una reunion o compartir el contexto de tu organizacion, este es el punto de partida mas claro."
    image={pageImages.contact}
    imageAlt="Sala de reuniones corporativa"
    highlights={[
      "Canales directos para agenda, correo y coordinacion.",
      "Formulario premium con experiencia clara y confiable.",
      "Atencion orientada a empresarios y organizaciones en crecimiento."
    ]}
    primaryCtaHref="/agendar-cita"
    primaryCtaLabel="Agendar cita"
    secondaryCtaHref="/servicios"
    secondaryCtaLabel="Ver servicios"
  />

  <section class="section-space-sm">
    <Container>
      <ContactChannels />
    </Container>
  </section>

  <section class="section-space">
    <Container class="grid gap-8 lg:grid-cols-[0.6fr_0.4fr]">
      <Card variant="premium" class="card-premium rounded-[2rem] p-6 md:p-8">
        <ContactFormSection />
      </Card>

      <Card variant="soft" class="rounded-[2rem] p-6 md:p-8">
        <ContactInfoSection />
      </Card>
    </Container>
  </section>

  <section class="section-space-sm" id="mapa">
    <Container>
      <Card variant="premium" class="card-premium overflow-hidden rounded-[2rem] p-0">
        <MapSection />
      </Card>
    </Container>
  </section>

  <section class="section-space-sm">
    <Container>
      <CTABox
        eyebrow="Otra via de contacto"
        title="Si prefieres una conversacion directa, agenda una reunion y avanzamos con mayor claridad."
        description="Podemos revisar tu caso, ordenar prioridades y ayudarte a decidir cual es el siguiente paso mas adecuado para tu organizacion."
        primaryCtaHref="/agendar-cita"
        primaryCtaLabel="Agendar una reunion"
        secondaryCtaHref="/privacidad"
        secondaryCtaLabel="Ver politica de privacidad"
      />
    </Container>
  </section>
</BaseLayout>
