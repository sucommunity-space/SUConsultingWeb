---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import CTABox from "../components/ui/CTABox.astro";
import BookingSteps from "../components/sections/booking/BookingSteps.astro";
import BookingEmbed from "../components/sections/booking/BookingEmbed.astro";
import BookingPolices from "../components/sections/booking/BookingPolices.astro";
import BookingFAQ from "../components/sections/booking/BookingFAQ.astro";
import { pageImages } from "../data/media";
---

<BaseLayout
  title="Agendar cita | SUConsulting"
  description="Agenda una reunion con SUConsulting de forma clara, ordenada y profesional."
>
  <PageHeader
    eyebrow="Agenda una reunion estrategica"
    title="Reservar una conversacion debe sentirse simple, clara y confiable."
    description="Esta pagina esta pensada para reducir friccion, ordenar expectativas y ayudarte a reservar una reunion con el equipo de SUConsulting con rapidez y seguridad."
    image={pageImages.booking}
    imageAlt="Reunion estrategica empresarial"
    highlights={[
      "Diagnostico inicial orientado a claridad estrategica.",
      "Reserva simple con confirmacion ordenada.",
      "Acompanamiento profesional desde el primer contacto."
    ]}
    primaryCtaHref="#agenda"
    primaryCtaLabel="Reservar ahora"
    secondaryCtaHref="/contacto"
    secondaryCtaLabel="Prefiero escribir primero"
  />

  <BookingSteps />

  <section class="section-space" id="agenda">
    <Container>
      <BookingEmbed />
    </Container>
  </section>

  <section class="section-space-sm bg-white">
    <Container>
      <BookingPolices />
    </Container>
  </section>

  <section class="section-space-sm">
    <Container>
      <BookingFAQ />
    </Container>
  </section>

  <section class="section-space-sm">
    <Container>
      <CTABox
        eyebrow="Canal alternativo"
        title="Si aun no estas listo para reservar, tambien podemos orientarte por contacto."
        description="Escribenos y revisaremos contigo si conviene agendar una reunion, explorar un servicio especifico o comenzar con una consulta inicial."
        primaryCtaHref="/contacto"
        primaryCtaLabel="Ir a contacto"
        secondaryCtaHref="/servicios"
        secondaryCtaLabel="Explorar servicios"
      />
    </Container>
  </section>
</BaseLayout>
