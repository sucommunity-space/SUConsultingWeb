---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import Container from "../components/ui/Container.astro";
import Card from "../components/ui/Card.astro";
import IconBox from "../components/ui/IconBox.astro";
import CTABox from "../components/ui/CTABox.astro";
import ServicesShowcase from "../components/sections/services/ServicesShowcase.astro";
import ProcessSection from "../components/sections/services/ProcessSection.astro";
import IndustriesSection from "../components/sections/services/IndustriesSection.astro";
import { pageImages } from "../data/media";

const differentiators = [
  {
    title: "Claridad financiera",
    description: "Leemos el negocio con foco en indicadores, sostenibilidad y decisiones medibles.",
    accent: "blue" as const
  },
  {
    title: "Orden estrategico",
    description: "Convertimos necesidades dispersas en rutas claras de trabajo y prioridades reales.",
    accent: "green" as const
  },
  {
    title: "Capacidad tecnica",
    description: "Combinamos criterio consultivo, procesos, tecnologia y acompanamiento aplicable.",
    accent: "magenta" as const
  }
];
---

<BaseLayout
  title="Servicios | SUConsulting"
  description="Explora los servicios estrategicos de SUConsulting para organizaciones que buscan crecer con orden, control y proposito."
>
  <PageHeader
    eyebrow="Servicios empresariales"
    title="Consultoria estrategica para crecer con mas estructura, orden y control."
    description="Acompanamos a emprendedores, PYMES y empresas familiares con servicios orientados a fortalecer gestion comercial, finanzas, procesos, continuidad y transformacion organizacional."
    image={pageImages.services}
    imageAlt="Sesion de estrategia empresarial"
    highlights={[
      "Diagnostico y direccion para negocios en crecimiento.",
      "Soluciones serias para gestion, procesos y tecnologia.",
      "Acompanamiento consultivo orientado a resultados sostenibles."
    ]}
    primaryCtaHref="/agendar-cita"
    primaryCtaLabel="Agendar una reunion"
    secondaryCtaHref="/contacto"
    secondaryCtaLabel="Solicitar orientacion"
  />

  <section class="section-space-sm services-intro-band">
    <Container>
      <div class="services-intro-grid grid gap-5 md:grid-cols-3">
        {differentiators.map((item, index) => (
          <Card variant="premium" class:list={["card-premium h-full p-6", "reveal", index === 1 && "reveal-delay-1", index === 2 && "reveal-delay-2"]}>
            <IconBox accent={item.accent} size="lg" value={String(index + 1).padStart(2, "0")} />
            <h2 class="mt-5 text-2xl font-black tracking-[-0.04em] text-[var(--brand-navy)]">
              {item.title}
            </h2>
            <p class="mt-3 text-[15px] leading-7 text-[var(--ink-2)]">
              {item.description}
            </p>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <ServicesShowcase />
  <ProcessSection />
  <IndustriesSection />

  <section class="section-space-sm">
    <Container>
      <CTABox
        tone="dark"
        eyebrow="Conversemos"
        title="Si tu empresa necesita mas direccion, este es un buen momento para ordenar el siguiente paso."
        description="Podemos revisar tu contexto, entender la prioridad mas urgente y recomendar un camino de trabajo sobrio, realista y estrategico."
        primaryCtaHref="/agendar-cita"
        primaryCtaLabel="Agendar una reunion"
        secondaryCtaHref="/contacto"
        secondaryCtaLabel="Hablar con nosotros"
      />
    </Container>
  </section>
</BaseLayout>
