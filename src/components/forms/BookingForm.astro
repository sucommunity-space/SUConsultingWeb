---
import Button from "../ui/Button.astro";
import * as servicesModule from "../../data/services";

interface Props {
  action?: string;
  class?: string;
}

const {
  action = "/backend/api/booking.php",
  class: className = ""
} = Astro.props;

type GenericRecord = Record<string, unknown>;
const moduleRecord = servicesModule as Record<string, unknown>;

const findArray = (): GenericRecord[] => {
  if (Array.isArray(moduleRecord.default)) return moduleRecord.default as GenericRecord[];

  for (const value of Object.values(moduleRecord)) {
    if (Array.isArray(value)) return value as GenericRecord[];
  }

  return [];
};

const rawServices = findArray();

const getText = (value: unknown, fallback = "") =>
  typeof value === "string" ? value : fallback;

const serviceOptions = rawServices.map((item, index) => ({
  label:
    getText(item.title) ||
    getText(item.name) ||
    `Servicio ${index + 1}`,
  value:
    (
      getText(item.slug) ||
      getText(item.title) ||
      getText(item.name) ||
      `servicio-${index + 1}`
    )
      .toLowerCase()
      .replaceAll(" ", "-")
}));

const options = serviceOptions.length
  ? serviceOptions
  : [
      { label: "Estrategia empresarial", value: "estrategia-empresarial" },
      { label: "Desarrollo organizacional", value: "desarrollo-organizacional" },
      { label: "Finanzas y sostenibilidad", value: "finanzas-y-sostenibilidad" },
      { label: "Innovacion y transformacion", value: "innovacion-y-transformacion" }
    ];
---

<form
  action={action}
  method="POST"
  class:list={["space-y-6", className]}
  data-booking-form
  novalidate
>
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    class="hidden"
    aria-hidden="true"
  />

  <input type="hidden" name="durationMinutes" value="60" />

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <label class="field-label" for="fullName">Nombre completo *</label>
      <input
        class="field-control"
        id="fullName"
        name="fullName"
        type="text"
        placeholder="Ej. Carlos Ramirez"
        required
        minlength="3"
      />
    </div>

    <div>
      <label class="field-label" for="email">Correo corporativo *</label>
      <input
        class="field-control"
        id="email"
        name="email"
        type="email"
        placeholder="Ej. carlos@empresa.com"
        required
      />
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <label class="field-label" for="phone">Telefono *</label>
      <input
        class="field-control"
        id="phone"
        name="phone"
        type="tel"
        placeholder="Ej. +51 987 654 321"
        required
        minlength="6"
      />
    </div>

    <div>
      <label class="field-label" for="service">Servicio *</label>
      <select
        class="field-control"
        id="service"
        name="service"
        required
      >
        <option value="">Selecciona una opcion</option>
        {options.map((option) => (
          <option value={option.label}>{option.label}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <label class="field-label" for="date">Fecha *</label>
      <input
        class="field-control"
        id="date"
        name="date"
        type="date"
        required
      />
    </div>

    <div>
      <label class="field-label" for="time">Hora *</label>
      <input
        class="field-control"
        id="time"
        name="time"
        type="time"
        required
      />
    </div>
  </div>

  <div>
    <label class="field-label" for="notes">Contexto o necesidad</label>
    <textarea
      class="field-control min-h-[180px] resize-y"
      id="notes"
      name="notes"
      placeholder="Cuentanos el reto principal que quieres revisar en la reunion"
    ></textarea>
  </div>

  <div class="rounded-[1.3rem] border border-[rgba(5,27,63,0.08)] bg-[rgba(5,27,63,0.03)] px-4 py-4">
    <p class="text-sm font-black text-[var(--brand-navy)]">Validacion de agenda</p>
    <p class="mt-2 text-[14px] leading-7 text-[var(--ink-2)]">
      Revisamos campos, bloqueamos bots basicos y consultamos el calendario antes de confirmar la reserva.
    </p>
  </div>

  <label class="flex items-start gap-3 rounded-[1.2rem] border border-[rgba(5,27,63,0.08)] bg-[rgba(5,27,63,0.02)] px-4 py-4">
    <input
      type="checkbox"
      name="privacy"
      value="accepted"
      class="mt-1 h-4 w-4 rounded border-[rgba(5,27,63,0.20)]"
      required
    />
    <span class="text-[14px] leading-7 text-[var(--ink-2)]">
      Acepto la <a href="/privacidad" class="font-black text-[var(--brand-magenta)]">Politica de Privacidad</a> y el tratamiento de mis datos para coordinar la reunion.
    </span>
  </label>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-sm text-[var(--ink-2)]">
      Te confirmaremos el espacio solo si el horario sigue disponible.
    </div>

    <Button type="submit" size="lg">
      Reservar reunion
    </Button>
  </div>

  <div
    class="hidden rounded-[1rem] border border-[rgba(113,175,46,0.20)] bg-[rgba(113,175,46,0.08)] px-4 py-3 text-sm font-bold text-[var(--brand-green)] whitespace-pre-line"
    data-form-success
    aria-live="polite"
  >
    Tu cita fue registrada correctamente.
  </div>

  <div
    class="hidden rounded-[1rem] border border-[rgba(225,86,121,0.20)] bg-[rgba(225,86,121,0.08)] px-4 py-3 text-sm font-bold text-[var(--brand-magenta)] whitespace-pre-line"
    data-form-error
    aria-live="polite"
  >
    Ocurrio un problema al registrar la cita. Intentalo de nuevo.
  </div>
</form>

<script>
  document.querySelectorAll("[data-booking-form]").forEach((formElement) => {
    const form = formElement as HTMLFormElement;
    const successBox = form.querySelector("[data-form-success]") as HTMLDivElement | null;
    const errorBox = form.querySelector("[data-form-error]") as HTMLDivElement | null;
    const dateInput = form.querySelector('input[name="date"]') as HTMLInputElement | null;

    if (!successBox || !errorBox) return;

    if (dateInput) {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, "0");
      const day = String(now.getDate()).padStart(2, "0");
      dateInput.min = `${year}-${month}-${day}`;
    }

    const formatConflictDetails = (details: unknown) => {
      if (!Array.isArray(details)) return "";

      const messages = details
        .map((detail) => {
          if (!detail || typeof detail !== "object") return "";

          const event = detail as {
            title?: string;
            startIso?: string;
            endIso?: string;
          };

          const title = typeof event.title === "string" && event.title.trim().length
            ? event.title.trim()
            : "Evento sin titulo";

          if (typeof event.startIso !== "string" || typeof event.endIso !== "string") {
            return `Conflicto detectado: ${title}.`;
          }

          const start = new Date(event.startIso);
          const end = new Date(event.endIso);

          if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) {
            return `Conflicto detectado: ${title}.`;
          }

          const durationMs = end.getTime() - start.getTime();
          const isAllDay = durationMs >= 23 * 60 * 60 * 1000;

          if (isAllDay) {
            return `Conflicto detectado: ${title} bloquea todo el dia.`;
          }

          const timeFormatter = new Intl.DateTimeFormat("es-PE", {
            timeStyle: "short",
            timeZone: "America/Lima"
          });

          return `Conflicto detectado: ${title} de ${timeFormatter.format(start)} a ${timeFormatter.format(end)}.`;
        })
        .filter((value) => value.length > 0);

      return messages.join("\n");
    };

    const getErrorMessage = (result: unknown) => {
      if (!result || typeof result !== "object") return "Ocurrio un problema al registrar la cita.";

      const payload = result as {
        message?: string;
        errors?: Record<string, string> | string[];
        code?: string;
        details?: unknown;
      };

      if (payload.errors) {
        if (Array.isArray(payload.errors)) return payload.errors.join("\n");

        const messages = Object.values(payload.errors).filter(
          (value): value is string => typeof value === "string" && value.length > 0
        );

        if (messages.length) return messages.join("\n");
      }

      if (payload.code === "SLOT_TAKEN") {
        const detailsMessage = formatConflictDetails(payload.details);

        if (detailsMessage) {
          return `${payload.message || "El horario solicitado ya esta ocupado."}\n${detailsMessage}`;
        }
      }

      return payload.message || "Ocurrio un problema al registrar la cita.";
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      successBox.classList.add("hidden");
      errorBox.classList.add("hidden");

      if (!form.reportValidity()) return;

      const submitter = form.querySelector('button[type="submit"], a[type="submit"]') as HTMLElement | null;
      submitter?.setAttribute("aria-busy", "true");

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        const response = await fetch(form.action, {
          method: form.method || "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({
            ...payload
          })
        });

        const raw = await response.text();
        let ok = response.ok;
        let message = "Solicitud procesada correctamente.";

        try {
          const result = JSON.parse(raw) as { ok?: boolean; message?: string; errors?: unknown };
          if (typeof result.ok === "boolean") ok = result.ok;
          message = ok ? (result.message || "Tu cita fue registrada correctamente.") : getErrorMessage(result);
        } catch {
          if (raw) message = raw;
        }

        if (ok) {
          successBox.textContent = message;
          successBox.classList.remove("hidden");
          form.reset();
        } else {
          errorBox.textContent = message;
          errorBox.classList.remove("hidden");
        }
      } catch {
        errorBox.textContent = "Ocurrio un problema al registrar la cita. Intentalo de nuevo.";
        errorBox.classList.remove("hidden");
      } finally {
        submitter?.removeAttribute("aria-busy");
      }
    });
  });
</script>
