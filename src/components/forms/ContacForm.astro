---
import Button from '../ui/Button.astro';
import { services } from '../../data/services';

const serviceList = services as Array<{ title: string }>;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form id="contact-form" class="grid gap-5" method="POST" action="/api/contact.php">
  <div class="grid gap-5 md:grid-cols-2">
    <label class="grid gap-2">
      <span class="text-sm font-bold text-[#051B3F]">Nombres y apellidos</span>
      <input type="text" name="name" required class="rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-[#346BB3]" placeholder="Tu nombre completo" />
    </label>

    <label class="grid gap-2">
      <span class="text-sm font-bold text-[#051B3F]">Correo electrónico</span>
      <input type="email" name="email" required class="rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-[#346BB3]" placeholder="correo@empresa.com" />
    </label>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <label class="grid gap-2">
      <span class="text-sm font-bold text-[#051B3F]">Teléfono</span>
      <input type="text" name="phone" class="rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-[#346BB3]" placeholder="+51 999 999 999" />
    </label>

    <label class="grid gap-2">
      <span class="text-sm font-bold text-[#051B3F]">Servicio de interés</span>
      <select name="service" class="rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-[#346BB3]">
        <option value="">Selecciona una opción</option>
        {serviceList.map((service) => <option value={service.title}>{service.title}</option>)}
      </select>
    </label>
  </div>

  <label class="grid gap-2">
    <span class="text-sm font-bold text-[#051B3F]">Mensaje</span>
    <textarea name="message" rows="6" required class="rounded-3xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-[#346BB3]" placeholder="Describe brevemente tu necesidad."></textarea>
  </label>

  <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid gap-2">
    <span class="text-sm font-bold text-[#051B3F]">Verificación de seguridad</span>
    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-theme="light"
      data-size="flexible"
    ></div>
  </div>

  <div id="form-status" class="hidden rounded-2xl px-4 py-3 text-sm font-semibold"></div>

  <div>
    <Button type="submit" size="lg">Enviar solicitud de contacto</Button>
  </div>
</form>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const statusBox = document.querySelector<HTMLDivElement>('#form-status');

    if (form && statusBox) {
    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        statusBox.className = 'hidden rounded-2xl px-4 py-3 text-sm font-semibold';

      const formData = new FormData(form);

      try {
        const response = await fetch('/api/contact.php', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();
        statusBox.textContent = result.message || 'Solicitud procesada.';
        statusBox.classList.remove('hidden');

        if (result.success) {
          statusBox.classList.add('border', 'border-green-200', 'bg-green-50', 'text-green-700');
          form.reset();
          if (window.turnstile) {
            window.turnstile.reset();
          }
        } else {
          statusBox.classList.add('border', 'border-red-200', 'bg-red-50', 'text-red-700');
        }
      } catch {
        statusBox.textContent = 'Ocurrió un error al enviar el formulario.';
        statusBox.classList.remove('hidden');
        statusBox.classList.add('border', 'border-red-200', 'bg-red-50', 'text-red-700');
      }
    });
  }
</script>