---
import Card from "../../ui/Card.astro";
import IconBox from "../../ui/IconBox.astro";
import GlyphIcon from "../../ui/GlyphIcon.astro";

const policies = [
  {
    title: "Duracion",
    description: "La reunion inicial esta pensada para concentrar contexto, diagnostico preliminar y siguiente paso sugerido.",
    accent: "blue" as const,
    icon: "clock" as const
  },
  {
    title: "Puntualidad",
    description: "Conectarte a la hora reservada ayuda a mantener una experiencia clara y ordenada para ambas partes.",
    accent: "green" as const,
    icon: "check" as const
  },
  {
    title: "Reprogramacion",
    description: "Si necesitas mover la cita, intenta hacerlo con anticipacion para cuidar la coordinacion del espacio reservado.",
    accent: "magenta" as const,
    icon: "refresh" as const
  },
  {
    title: "Privacidad",
    description: "La informacion compartida durante la reserva y la reunion se trata con cuidado y criterio profesional.",
    accent: "orange" as const,
    icon: "shield" as const
  }
];
---

<Card variant="soft" class="rounded-[2rem] p-6 md:p-8">
  <div class="max-w-3xl">
    <p class="text-sm font-black uppercase tracking-[0.18em] text-[var(--brand-blue)]">
      Politicas y lineamientos
    </p>
    <h2 class="mt-3 text-3xl font-black tracking-[-0.05em] text-[var(--brand-navy)] md:text-4xl">
      Reglas simples para una experiencia profesional desde el inicio
    </h2>
    <p class="mt-4 text-[15px] leading-7 text-[var(--ink-2)]">
      Comunicamos expectativas con claridad para que la reserva se sienta segura, ordenada y alineada al tipo de marca que representamos.
    </p>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {policies.map((item, index) => (
      <div class:list={["rounded-[1.5rem] border border-[rgba(5,27,63,0.08)] bg-white p-5", "reveal", index % 2 === 1 && "reveal-delay-1"]}>
        <IconBox accent={item.accent}>
          <GlyphIcon name={item.icon} />
        </IconBox>
        <h3 class="mt-5 text-2xl font-black tracking-[-0.04em] text-[var(--brand-navy)]">
          {item.title}
        </h3>
        <p class="mt-3 text-[15px] leading-7 text-[var(--ink-2)]">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</Card>
