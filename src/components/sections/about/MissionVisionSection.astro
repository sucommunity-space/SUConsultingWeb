---
import Container from "../../ui/Container.astro";
import Card from "../../ui/Card.astro";
import IconBox from "../../ui/IconBox.astro";
import GlyphIcon from "../../ui/GlyphIcon.astro";

const principles = [
  "Servicio con base de fe",
  "Orden para sostener crecimiento",
  "Relacion de acompanamiento de largo plazo"
];
---

<section class="section-space-sm">
  <Container>
    <div class="grid gap-6 xl:grid-cols-[1fr_1fr_0.8fr]">
      <Card variant="premium" class="card-premium p-7 md:p-8">
        <IconBox accent="blue" size="lg">
          <GlyphIcon name="mission" />
        </IconBox>
        <p class="mt-5 text-sm font-black uppercase tracking-[0.18em] text-[var(--brand-blue)]">
          Mision
        </p>
        <h2 class="mt-3 text-3xl font-black tracking-[-0.05em] text-[var(--brand-navy)] md:text-4xl">
          Acompanar decisiones empresariales con criterio, servicio y proposito.
        </h2>
        <p class="mt-5 text-[15px] leading-8 text-[var(--ink-2)]">
          Servimos a lideres, emprendedores y organizaciones que necesitan ordenar su gestion,
          fortalecer su direccion y avanzar con una estrategia que sea humana, profesional y sostenible.
        </p>
      </Card>

      <Card variant="dark" class="relative overflow-hidden rounded-[1.8rem] p-7 md:p-8 suc-pattern">
        <IconBox accent="magenta" size="lg">
          <GlyphIcon name="vision" />
        </IconBox>
        <p class="mt-5 text-sm font-black uppercase tracking-[0.18em] text-white/66">
          Vision
        </p>
        <h2 class="mt-3 text-3xl font-black tracking-[-0.05em] text-white md:text-4xl">
          Construir una red consultiva confiable para el crecimiento con sentido.
        </h2>
        <p class="mt-5 text-[15px] leading-8 text-white/76">
          Aspiramos a consolidar una consultora reconocida por su autoridad profesional,
          su cercania institucional y su capacidad de impulsar empresas con mayor continuidad,
          mejor estructura y decisiones mas maduras.
        </p>
      </Card>

      <Card variant="outline" class="rounded-[1.8rem] border border-[rgba(5,27,63,0.08)] p-7 md:p-8">
        <p class="text-sm font-black uppercase tracking-[0.18em] text-[var(--brand-orange)]">
          Principios institucionales
        </p>
        <div class="mt-6 space-y-4">
          {principles.map((item, index) => (
            <div class:list={["rounded-[1.3rem] border border-[rgba(5,27,63,0.08)] bg-white px-4 py-4", "reveal", index === 1 && "reveal-delay-1", index === 2 && "reveal-delay-2"]}>
              <p class="text-[15px] font-extrabold leading-7 text-[var(--brand-navy)]">{item}</p>
            </div>
          ))}
        </div>
      </Card>
    </div>
  </Container>
</section>
