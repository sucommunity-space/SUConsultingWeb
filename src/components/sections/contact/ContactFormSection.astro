---
import ContactForm from "../../forms/ContactForm.astro";
import IconBox from "../../ui/IconBox.astro";

const trustPillars = [
  {
    title: "Atencion personalizada",
    text: "Escuchamos el contexto antes de proponer un siguiente paso.",
    accent: "blue" as const,
    mark: "01"
  },
  {
    title: "Canal empresarial",
    text: "La informacion se recibe con orden, criterio y respuesta profesional.",
    accent: "green" as const,
    mark: "02"
  },
  {
    title: "Privacidad y confianza",
    text: "Tus datos y tu mensaje se tratan con seriedad institucional.",
    accent: "magenta" as const,
    mark: "03"
  }
];
---

<div>
  <p class="text-sm font-black uppercase tracking-[0.18em] text-[var(--brand-magenta)]">
    Envia tu consulta
  </p>

  <h2 class="mt-3 text-3xl font-black tracking-[-0.05em] text-[var(--brand-navy)] md:text-4xl">
    Cuentanos como podemos ayudarte
  </h2>

  <p class="mt-4 max-w-3xl text-[15px] leading-7 text-[var(--ink-2)]">
    El formulario debe sentirse claro, seguro y facil de completar. Queremos que la primera impresion sea tan profesional como la conversacion posterior.
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {trustPillars.map((item, index) => (
      <div class:list={["rounded-[1.35rem] border border-[rgba(5,27,63,0.08)] bg-[rgba(5,27,63,0.02)] p-4", "reveal", index > 0 && `reveal-delay-${index}`]}>
        <IconBox accent={item.accent} value={item.mark} />
        <p class="mt-4 text-sm font-black text-[var(--brand-navy)]">{item.title}</p>
        <p class="mt-2 text-[14px] leading-6 text-[var(--ink-2)]">{item.text}</p>
      </div>
    ))}
  </div>

  <div class="mt-8">
    <ContactForm />
  </div>
</div>
