---
interface Props {
    href?: string;
    label?: string;
    variant?: 'primary' | 'secondary' | 'ghost';
    size?: 'sm' | 'md' | 'lg';
    class?: string;
    target?: string;
    rel?: string;
    type?: 'button' | 'submit' | 'reset';
    ariaLabel?: string;
  }
  
  const {
    href,
    label,
    variant = 'primary',
    size = 'md',
    class: className = '',
    target,
    rel,
    type = 'button',
    ariaLabel
  } = Astro.props;
  
  const base =
    'inline-flex items-center justify-center rounded-full font-semibold tracking-[0.01em] transition duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#346BB3]';
  
  const variants = {
    primary:
      'glow-button bg-[#051B3F] text-white hover:-translate-y-0.5 hover:bg-[#08285A]',
    secondary:
      'border border-[#051B3F]/12 bg-white text-[#051B3F] hover:-translate-y-0.5 hover:border-[#346BB3] hover:text-[#346BB3] hover:bg-[#F8FBFF]',
    ghost:
      'bg-transparent text-[#051B3F] hover:bg-[#051B3F]/5'
  };
  
  const sizes = {
    sm: 'px-4 py-2.5 text-sm',
    md: 'px-5 py-3 text-sm md:px-6 md:text-base',
    lg: 'px-6 py-3.5 text-base md:px-7 md:py-4'
  };
  
  const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
  ---
  {
    href ? (
      <a href={href} target={target} rel={rel} class={classes} aria-label={ariaLabel}>
        <slot>{label}</slot>
      </a>
    ) : (
      <button type={type} class={classes} aria-label={ariaLabel}>
        <slot>{label}</slot>
      </button>
    )
  }