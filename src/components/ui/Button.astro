---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "soft" | "ghost" | "light" | "outline-light";
  size?: "sm" | "md" | "lg";
  effect?: "default" | "liquid";
  class?: string;
  full?: boolean;
  target?: string;
  rel?: string;
  [key: string]: any;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  effect = "liquid",
  class: className = "",
  full = false,
  target,
  rel,
  ...attrs
} = Astro.props;

const Tag = href ? "a" : "button";

const safeRel =
  href && target === "_blank"
    ? rel || "noopener noreferrer"
    : rel;

const classes = [
  "btn",
  `btn--${variant}`,
  `btn--${size}`,
  effect === "liquid" ? "btn--liquid" : "",
  full ? "btn--full" : "",
  className
].filter(Boolean).join(" ");
---

<Tag
  {...attrs}
  href={href}
  type={href ? undefined : type}
  class={classes}
  target={href ? target : undefined}
  rel={href ? safeRel : undefined}
>
  <span class="btn__content">
    <slot />
  </span>
</Tag>
