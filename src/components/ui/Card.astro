---
interface Props {
  variant?: "default" | "soft" | "feature" | "dark" | "premium" | "outline";
  class?: string;
  style?: string;
  id?: string;
  [key: string]: any;
}

const {
  variant = "default",
  class: className = "",
  style,
  ...attrs
} = Astro.props;

const classes = [
  "card",
  `card--${variant}`,
  className
].filter(Boolean).join(" ");
---

<div {...attrs} class={classes} style={style}>
  <slot />
</div>
