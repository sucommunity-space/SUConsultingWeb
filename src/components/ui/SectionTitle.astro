---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
  titleClass?: string;
  [key: string]: any;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = "",
  titleClass = "",
  ...attrs
} = Astro.props;

const isCenter = align === "center";
---

<div
  {...attrs}
  class:list={[
    "section-title-block",
    isCenter ? "section-title-block--center" : "",
    className
  ]}
>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}

  <h2 class={`section-title ${titleClass}`}>
    {title}
  </h2>

  {description && (
    <p class="lead">
      {description}
    </p>
  )}
</div>