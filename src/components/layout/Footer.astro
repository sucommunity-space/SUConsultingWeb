---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Logo from "../ui/Logo.astro";
import { navigation, type NavigationItem } from "../../data/navigation";
import { site } from "../../data/site";

const phone = "+51 987 654 321";
const email = site.email;
const currentYear = new Date().getFullYear();

const serviceLinks = [
  "Estrategia empresarial",
  "Desarrollo organizacional",
  "Finanzas y sostenibilidad",
  "Innovacion y transformacion"
];

const brandPillars = ["Estrategia", "Integridad", "Proposito"];
---

<footer class="site-footer">


  <Container class="site-footer__inner">
    <div class="site-footer__panel">
      <div class="site-footer__brand">
        <div class="site-footer__brand-head">
          <p class="site-footer__eyebrow">Consultoria estrategica boutique</p>
          <a href="/" class="site-footer__brand-link" aria-label="Ir al inicio">
            <Logo tone="light" class="site-footer__logo" />
          </a>
        </div>

        <p class="site-footer__brand-copy">
          Acompa&ntilde;amos a lideres, emprendedores y organizaciones con
          visi&oacute;n, integridad y prop&oacute;sito para crecer con una estrategia
          clara, ordenada y sostenible.
        </p>

        <div class="site-footer__pillars" aria-label="Pilares de marca">
          {brandPillars.map((pillar) => (
            <span class="site-footer__pillar">{pillar}</span>
          ))}
        </div>
      </div>

      <div class="site-footer__columns">
        <div class="site-footer__column">
          <h3>Navegacion</h3>
          <ul>
            {navigation.map((item: NavigationItem) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="site-footer__column">
          <h3>Servicios</h3>
          <ul>
            {serviceLinks.map((service) => (
              <li>
                <a href="/servicios">{service}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="site-footer__column site-footer__column--contact">
          <h3>Contacto</h3>
          <ul>
            <li><a href={`tel:${phone.replace(/\s+/g, "")}`}>{phone}</a></li>
            <li><a href={`mailto:${email}`}>{email}</a></li>
            <li><span>Lima, Per&uacute;</span></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {currentYear} SUConsulting. Todos los derechos reservados.</p>

      <div class="site-footer__bottom-links">
        <a href="/privacidad">Politica de Privacidad</a>
        <a href="/privacidad">Aviso legal</a>
      </div>
    </div>
  </Container>
</footer>
