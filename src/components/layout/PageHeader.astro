---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Logo from "../ui/Logo.astro";
import BrandOrnaments from "../ui/BrandOrnaments.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  highlights?: string[];
  primaryCtaHref?: string;
  primaryCtaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaLabel?: string;
  variant?: "internal" | "minimal";
}

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt = "Imagen institucional",
  highlights = [],
  primaryCtaHref,
  primaryCtaLabel,
  secondaryCtaHref,
  secondaryCtaLabel,
  variant = "internal"
} = Astro.props;

const hasImage = variant !== "minimal" && Boolean(image);
---

<section class:list={["internal-hero", `internal-hero--${variant}`, !hasImage && "internal-hero--no-media"]}>
  {variant === "internal" && (
    <>
      <div class="internal-hero__backdrop" aria-hidden="true">
        {image && <img src={image} alt="" class="internal-hero__bg-image" loading="eager" decoding="async" />}
      </div>
      <div class="internal-hero__grid-pattern" aria-hidden="true"></div>
      <BrandOrnaments />
    </>
  )}

  <Container class="internal-hero__inner">
    <div class="internal-hero__content reveal">
      {eyebrow && <span class="eyebrow internal-hero__eyebrow">{eyebrow}</span>}

      <h1 class="internal-hero__title">{title}</h1>

      {description && <p class="internal-hero__lead">{description}</p>}

      {(primaryCtaHref || secondaryCtaHref) && (
        <div class="internal-hero__actions reveal reveal-delay-1">
          {primaryCtaHref && primaryCtaLabel && (
            <Button href={primaryCtaHref} size="lg" variant={variant === "internal" ? "light" : "primary"}>
              {primaryCtaLabel}
            </Button>
          )}

          {secondaryCtaHref && secondaryCtaLabel && (
            <Button href={secondaryCtaHref} size="lg" variant={variant === "internal" ? "outline-light" : "secondary"}>
              {secondaryCtaLabel}
            </Button>
          )}
        </div>
      )}

      {highlights.length > 0 && (
        <ul class="internal-hero__highlights reveal reveal-delay-2">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}

      {variant === "internal" && (
        <div class="internal-hero__signature reveal reveal-delay-2">
          <span aria-hidden="true"></span>
          Estrategia que transforma. Valores que permanecen.
        </div>
      )}
    </div>

    {hasImage && (
      <div class="internal-hero__visual reveal reveal-delay-1">
        <div class="internal-hero__media image-premium">
          <img
            src={image}
            alt={imageAlt}
            class="internal-hero__image"
            loading="eager"
            decoding="async"
          />

          <div class="internal-hero__media-overlay"></div>

          <div class="internal-hero__stamp">
            <span>Consultoria empresarial</span>
            <Logo tone="light" class="internal-hero__stamp-logo" />
          </div>
        </div>
      </div>
    )}
  </Container>
</section>
