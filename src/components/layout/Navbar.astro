---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Logo from "../ui/Logo.astro";
import MobilNavToggle from "./MobilNavToggle.astro";
import { navigation, type NavigationItem } from "../../data/navigation";

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-[rgba(5,27,63,0.08)] bg-[rgba(255,255,255,0.82)] backdrop-blur-xl" data-mobile-nav-root>
  <Container class="flex h-20 items-center justify-between gap-6">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-3 transition-transform duration-300 hover:scale-[1.01]"
      aria-label="Ir al inicio"
    >
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {navigation.map((item: NavigationItem) => (
        <a
          href={item.href}
          class:list={[
            "group relative rounded-full px-4 py-2.5 text-sm font-extrabold transition-all duration-300",
            isActive(item.href)
              ? "text-[var(--brand-navy)]"
              : "text-[var(--ink-2)] hover:bg-[rgba(5,27,63,0.04)] hover:text-[var(--brand-navy)]"
          ]}
        >
          <span>{item.label}</span>

          <span
            class:list={[
              "absolute inset-x-4 -bottom-[3px] h-[3px] rounded-full bg-[var(--brand-navy)] transition-all duration-300",
              isActive(item.href)
                ? "opacity-100"
                : "scale-x-0 opacity-0 group-hover:scale-x-100 group-hover:opacity-100"
            ]}
          ></span>
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <Button href="/agendar-cita" size="md">
        Hablemos
        <span aria-hidden="true">-&gt;</span>
      </Button>
    </div>

    <div class="lg:hidden">
      <MobilNavToggle
        controls="mobile-menu-panel"
        expanded="false"
        data-mobile-menu-toggle
      />
    </div>
  </Container>
</header>

<div
  id="mobile-menu-panel"
  class="mobile-menu"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Menu principal"
  inert
>
  <div class="mobile-menu__panel">
    <div class="mobile-menu__header">
      <a href="/" class="mobile-menu__brand" aria-label="Ir al inicio">
        <Logo tone="light" class="mobile-menu__logo-wrap" />
      </a>

      <button
        type="button"
        class="mobile-menu__close"
        aria-label="Cerrar menu"
        data-mobile-menu-close
      >
        <span></span>
        <span></span>
      </button>
    </div>

    <p class="mobile-menu__copy">
      Consultoria empresarial premium para decisiones con criterio, estructura y acompanamiento real.
    </p>

    <nav class="mobile-menu__nav" aria-label="Navegacion movil">
      {navigation.map((item: NavigationItem, index) => (
        <a
          href={item.href}
          class:list={[
            "mobile-menu__link",
            isActive(item.href) && "is-active"
          ]}
        >
          <span>{item.label}</span>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        </a>
      ))}
    </nav>

    <div class="mobile-menu__footer">
      <a class="mobile-menu__cta mobile-menu__cta--primary" href="/agendar-cita">
        Agendar una reunion
      </a>

      <p class="mobile-menu__note">
        Estrategia que transforma. Valores que permanecen.
      </p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const initMobileMenu = () => {
      const root = document.querySelector("[data-mobile-nav-root]");
      const toggle = document.querySelector("[data-mobile-menu-toggle]");
      const menu = document.getElementById("mobile-menu-panel");
      const closeButton = document.querySelector("[data-mobile-menu-close]");

      if (!(root instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) {
        return;
      }

      if (root.dataset.mobileMenuBound === "true") {
        return;
      }

      root.dataset.mobileMenuBound = "true";

      const links = Array.from(menu.querySelectorAll("a"));
      let scrollY = 0;

      const previousStyles = {
        overflowHtml: "",
        overflowBody: "",
        positionBody: "",
        topBody: "",
        leftBody: "",
        rightBody: "",
        widthBody: ""
      };

      const openMenu = () => {
        scrollY = window.scrollY;

        previousStyles.overflowHtml = document.documentElement.style.overflow;
        previousStyles.overflowBody = document.body.style.overflow;
        previousStyles.positionBody = document.body.style.position;
        previousStyles.topBody = document.body.style.top;
        previousStyles.leftBody = document.body.style.left;
        previousStyles.rightBody = document.body.style.right;
        previousStyles.widthBody = document.body.style.width;

        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        document.body.style.position = "fixed";
        document.body.style.top = `-${scrollY}px`;
        document.body.style.left = "0";
        document.body.style.right = "0";
        document.body.style.width = "100%";

        menu.removeAttribute("inert");
        menu.classList.add("is-open");
        menu.setAttribute("aria-hidden", "false");
        toggle.setAttribute("aria-expanded", "true");
        if (closeButton instanceof HTMLButtonElement) {
          closeButton.focus({ preventScroll: true });
        }
      };

      const closeMenu = () => {
        const activeElement = document.activeElement;
        if (activeElement instanceof HTMLElement && menu.contains(activeElement)) {
          toggle.focus({ preventScroll: true });
        }

        menu.classList.remove("is-open");
        menu.setAttribute("aria-hidden", "true");
        menu.setAttribute("inert", "");
        toggle.setAttribute("aria-expanded", "false");

        document.documentElement.style.overflow = previousStyles.overflowHtml;
        document.body.style.overflow = previousStyles.overflowBody;
        document.body.style.position = previousStyles.positionBody;
        document.body.style.top = previousStyles.topBody;
        document.body.style.left = previousStyles.leftBody;
        document.body.style.right = previousStyles.rightBody;
        document.body.style.width = previousStyles.widthBody;

        window.scrollTo(0, scrollY);
      };

      const toggleMenu = () => {
        if (menu.classList.contains("is-open")) {
          closeMenu();
          return;
        }

        openMenu();
      };

      toggle.addEventListener("click", toggleMenu);

      if (closeButton instanceof HTMLButtonElement) {
        closeButton.addEventListener("click", closeMenu);
      }

      links.forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      menu.addEventListener("click", (event) => {
        if (event.target === menu) {
          closeMenu();
        }
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.classList.contains("is-open")) {
          closeMenu();
        }
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024 && menu.classList.contains("is-open")) {
          closeMenu();
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMobileMenu, { once: true });
      return;
    }

    initMobileMenu();
  })();
</script>
