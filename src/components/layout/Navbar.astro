---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

const siteData = site as {
  name: string;
  nav?: Array<{ label: string; href: string }>;
};

const navItems = siteData.nav ?? [];
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---
<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/88 backdrop-blur-xl">
  <Container class="flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3">
      <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#051B3F] text-lg font-extrabold text-white shadow-[0_12px_24px_rgba(5,27,63,0.18)]">
        SU
      </span>
      <div class="flex flex-col leading-none">
        <span class="text-lg font-extrabold tracking-tight text-[#051B3F]">
          {siteData.name}
        </span>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
          Consultoría estratégica
        </span>
      </div>
    </a>

    <nav class="hidden items-center gap-7 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class={`relative text-sm font-semibold transition ${
              isActive(item.href)
                ? 'text-[#051B3F]'
                : 'text-slate-500 hover:text-[#346BB3]'
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <Button href="/agendar-cita" size="md">Agendar cita</Button>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-slate-200 bg-white text-[#051B3F] shadow-sm">
        <div class="flex flex-col gap-1.5">
          <span class="h-0.5 w-5 rounded-full bg-current"></span>
          <span class="h-0.5 w-5 rounded-full bg-current"></span>
          <span class="h-0.5 w-5 rounded-full bg-current"></span>
        </div>
      </summary>

      <div class="absolute right-0 top-14 w-[min(88vw,320px)] rounded-[1.75rem] border border-slate-200 bg-white p-4 shadow-[0_18px_40px_rgba(5,27,63,0.14)]">
        <nav class="flex flex-col gap-1">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`rounded-2xl px-4 py-3 text-sm font-semibold ${
                  isActive(item.href)
                    ? 'bg-[#051B3F]/6 text-[#051B3F]'
                    : 'text-slate-600 hover:bg-slate-50 hover:text-[#346BB3]'
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="mt-4 border-t border-slate-200 pt-4">
          <Button href="/agendar-cita" class="w-full">Agendar cita</Button>
        </div>
      </div>
    </details>
  </Container>
</header>